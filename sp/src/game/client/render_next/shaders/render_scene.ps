struct PSInput
{
    float4 position : SV_POSITION;
    float3 normal : NORMAL;
    float2 texcoord : TEXCOORD0;
    float2 lightmap_texcoord : TEXCOORD1;
    uint material_index : TEXCOORD2;
    float3 color : TEXCOORD3;
    float4 curr_clip_position : TEXCOORD4;
    float4 prev_clip_position : TEXCOORD5;
};

cbuffer CameraCB : register(b0)
{
    float4x4 g_view_projection;
    float4x4 g_prev_view_projection;
    float4 g_camera_jitter;
};

static const uint RENDER_NEW_MAX_TEXTURES = 512;

struct MaterialData
{
    uint albedo_texture_id;
    uint alpha_test;
    float alpha_test_reference;
    float padding0;
};

Texture2D g_textures[RENDER_NEW_MAX_TEXTURES] : register(t0, space1);
Texture2D g_lightmap : register(t0, space3);
StructuredBuffer<MaterialData> g_scene_materials : register(t7);
SamplerState g_sampler : register(s0, space2);
SamplerState g_lightmap_sampler : register(s1, space2);

struct PSOutput
{
    float4 color : SV_TARGET0;
    float2 velocity : SV_TARGET1;
};

float3 SrgbToLinear(float3 color)
{
    float3 use_linear = step(color, float3(0.04045f, 0.04045f, 0.04045f));
    float3 linear_low = color / 12.92f;
    float3 linear_high = pow((color + 0.055f) / 1.055f, 2.4f);
    return lerp(linear_high, linear_low, use_linear);
}

float3 LinearToSrgb(float3 color)
{
    color = saturate(color);
    float3 use_linear = step(color, float3(0.0031308f, 0.0031308f, 0.0031308f));
    float3 srgb_low = color * 12.92f;
    float3 srgb_high = 1.055f * pow(color, 1.0f / 2.4f) - 0.055f;
    return lerp(srgb_high, srgb_low, use_linear);
}

PSOutput main(PSInput input)
{
    PSOutput output;
    float3 light = normalize(float3(0.5f, 0.75f, 1.0f));
    float3 normal = normalize(input.normal);
    float diffuse = 1.0f;//saturate(dot(normal, light)) + 0.1f;
    MaterialData material = g_scene_materials[input.material_index];
    float4 albedo = g_textures[NonUniformResourceIndex(material.albedo_texture_id)].Sample(g_sampler, input.texcoord);
    if (material.alpha_test != 0)
    {
        clip(albedo.a - material.alpha_test_reference);
    }

    float3 albedo_linear = SrgbToLinear(albedo.rgb);
    float3 lightmap_linear = g_lightmap.Sample(g_lightmap_sampler, input.lightmap_texcoord).rgb;
    float3 direct_linear = albedo_linear * diffuse * input.color;
    float3 output_color = LinearToSrgb(direct_linear * lightmap_linear);

    float2 curr_ndc = input.curr_clip_position.xy / max(abs(input.curr_clip_position.w), 1e-6f);
    float2 prev_ndc = input.prev_clip_position.xy / max(abs(input.prev_clip_position.w), 1e-6f);
    float2 curr_uv = float2(curr_ndc.x, -curr_ndc.y) * 0.5f + 0.5f;
    float2 prev_uv = float2(prev_ndc.x, -prev_ndc.y) * 0.5f + 0.5f;
    float2 jitter_delta = g_camera_jitter.xy - g_camera_jitter.zw;
    jitter_delta.x *= 0.5f;
    jitter_delta.y *= -0.5f;

    output.color = float4(output_color, albedo.a);
    output.velocity = (curr_uv - prev_uv - jitter_delta);
    return output;
}
