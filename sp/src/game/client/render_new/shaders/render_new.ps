struct PSInput
{
    float4 position : SV_POSITION;
    float3 normal : NORMAL;
    float2 texcoord : TEXCOORD0;
    uint texture_index : TEXCOORD1;
};

static const uint RENDER_NEW_MAX_TEXTURES = 512;

Texture2D g_textures[RENDER_NEW_MAX_TEXTURES] : register(t0, space1);
SamplerState g_sampler : register(s0, space2);

float4 main(PSInput input) : SV_TARGET
{
    float3 light = normalize(float3(0.5f, 0.75f, 1.0f));
    float3 normal = normalize(input.normal);
    float diffuse = saturate(dot(normal, light));
    float4 albedo = g_textures[NonUniformResourceIndex(input.texture_index)].Sample(g_sampler, input.texcoord);
    return float4(albedo.rgb * diffuse, albedo.a);
}